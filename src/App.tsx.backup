              </div>
            </section>
          </RevealOnScroll>

          {/* ============================================================== */}
          {/* SECTION 3: CORE SKILLS & TOOLS                                 */}
          {/* ============================================================== */}
          <RevealOnScroll>
            <section id="skills-tools" className="flex flex-col gap-6 scroll-mt-24">
              <div className="flex items-center gap-3 border-b border-gray-800 pb-3">
                <Cpu className={`w-6 h-6 ${activeTheme.accentText}`} />
                <h2 className="font-display font-black text-xl md:text-2xl text-white tracking-widest uppercase glitch-hover cursor-pointer">
